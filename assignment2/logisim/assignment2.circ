  <vhdl name="and_or4" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity and_or4 is
  port (a, b, c, d : in std_logic;
        out1, out2 : out std_logic);
end and_or4;

architecture rtl of and_or4 is
begin
  out1 &lt;= a and b and c and d;
  out2 &lt;= a or b or c or d;
end rtl;
</vhdl>
  <vhdl name="mux8" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity mux8 is
  port (d : in std_logic_vector(7 downto 0);
        s : in std_logic_vector(2 downto 0);
        y : out std_logic);
end mux8;

architecture rtl of mux8 is
begin
  -- s=000 selects d(0), s=111 selects d(7).
  with s select y &lt;=
    d(0) when "000", d(1) when "001",
    d(2) when "010", d(3) when "011",
    d(4) when "100", d(5) when "101",
    d(6) when "110", d(7) when "111",
    'X' when others;
end rtl;
</vhdl>
  <vhdl name="letters7seg" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity letters7seg is
  port (sel : in std_logic_vector(2 downto 0);
        seg : out std_logic_vector(7 downto 0));
end letters7seg;

architecture rtl of letters7seg is
begin
  -- seg(7 downto 0) = a,b,c,d,e,f,g,dp; 1 turns a segment on.
  -- 000..101: a,b,c,d,f,g (A,b,C,d,F,G on seven segments).
  with sel select seg &lt;=
    "11101110" when "000",
    "00111110" when "001",
    "10011100" when "010",
    "01111010" when "011",
    "10001110" when "100",
    "10111110" when "101",
    "00000000" when others;
end rtl;
</vhdl>
  <vhdl name="voting25" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity voting25 is
  port (vt : in std_logic_vector(24 downto 0);
        result : out std_logic);
end voting25;

architecture rtl of voting25 is
begin
  process(vt)
    variable count : integer range 0 to 25;
    variable valid : boolean;
  begin
    count := 0;
    valid := true;
    for i in vt'range loop
      if vt(i) = '1' then count := count + 1;
      elsif vt(i) /= '0' then valid := false;
      end if;
    end loop;
    if not valid then result &lt;= 'X';
    elsif count &gt;= 13 then result &lt;= '1';
    else result &lt;= '0';
    end if;
  end process;
end rtl;
</vhdl>
  <vhdl name="popcount13_display" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity popcount13_display is
  port (vt : in std_logic_vector(12 downto 0);
        en : in std_logic;
        seg : out std_logic_vector(7 downto 0));
end popcount13_display;

architecture rtl of popcount13_display is
begin
  process(vt, en)
    variable count : integer range 0 to 13;
    variable valid : boolean;
  begin
    count := 0;
    valid := true;
    for i in vt'range loop
      if vt(i) = '1' then count := count + 1;
      elsif vt(i) /= '0' then valid := false;
      end if;
    end loop;
    if en = '0' then seg &lt;= "00000000";
    elsif en /= '1' or not valid then seg &lt;= (others =&gt; 'X');
    else
      case count is
        when 0 =&gt; seg &lt;= "11111100";
        when 1 =&gt; seg &lt;= "01100000";
        when 2 =&gt; seg &lt;= "11011010";
        when 3 =&gt; seg &lt;= "11110010";
        when 4 =&gt; seg &lt;= "01100110";
        when 5 =&gt; seg &lt;= "10110110";
        when 6 =&gt; seg &lt;= "10111110";
        when 7 =&gt; seg &lt;= "11100000";
        when 8 =&gt; seg &lt;= "11111110";
        when 9 =&gt; seg &lt;= "11110110";
        when 10 =&gt; seg &lt;= "11101110";
        when 11 =&gt; seg &lt;= "00111110";
        when 12 =&gt; seg &lt;= "10011100";
        when 13 =&gt; seg &lt;= "01111010";
        -- E and F are defined for a reusable hexadecimal decoder;
        -- 14 and 15 are unreachable with a 13-bit input.
        when others =&gt; seg &lt;= "00000000";
      end case;
    end if;
  end process;
end rtl;
</vhdl>
  <vhdl name="hex7seg" appearance="logisim_evolution">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity hex7seg is
  port (n : in std_logic_vector(3 downto 0);
        seg : out std_logic_vector(7 downto 0));
end hex7seg;

architecture rtl of hex7seg is
begin
  -- seg = abcdefg dp, active high.
  with n select seg &lt;=
    "11111100" when "0000",
    "01100000" when "0001",
    "11011010" when "0010",
    "11110010" when "0011",
    "01100110" when "0100",
    "10110110" when "0101",
    "10111110" when "0110",
    "11100000" when "0111",
    "11111110" when "1000",
    "11110110" when "1001",
    "11101110" when "1010",
    "00111110" when "1011",
    "10011100" when "1100",
    "01111010" when "1101",
    "10011110" when "1110",
    "10001110" when "1111",
    (others =&gt; 'X') when others;
end rtl;
</vhdl>
</project>